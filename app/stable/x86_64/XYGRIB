BAPP=4.0
ID=XYGRIB
Name=XYGrib
Comment="Grib File Viewer"
Ver=Update:REPO
localVer=0
W3=

INSTALL(){
    PKG_INSTALL xygrib xygrib-maps
}

UPDATE(){
    INSTALL
}

REMOVE(){
    PKG_REMOVE xygrib xygrib-maps
}

VERSION(){
	if ! hash xygrib 2>/dev/null; then
		CURRENT=0
        NEWVER=REPO
    else
        CURRENT=REPO
        NEWVER=REPO
    fi
}
