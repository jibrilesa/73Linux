BAPP=4.0
ID=CQRLOG
Name=CQRLOG
Comment="Logging Software"
Ver=
localVer=
W3=

INSTALL(){
    if [ -n "$IS_SUSE" ]; then
        #packaged in the openSUSE hamradio repo
        PKG_INSTALL cqrlog mariadb-server mariadb-client
        return
    fi

    PKG_INSTALL lcl-2.0
    PKG_INSTALL lazarus
    PKG_INSTALL lcl
    PKG_INSTALL fp-utils
    PKG_INSTALL fp-units-misc
    PKG_INSTALL fp-units-gfx
    PKG_INSTALL fp-units-gtk2
    PKG_INSTALL fp-units-db
    PKG_INSTALL fp-units-math
    PKG_INSTALL fp-units-net
    PKG_INSTALL libssl-dev
    PKG_INSTALL mariadb-server
    PKG_INSTALL mariadb-client
    PKG_INSTALL default-libmysqlclient-dev

    cd ${BAPSRC}
	rm -rf cqrlog
	mkdir cqrlog
	cd cqrlog

    git clone https://github.com/ok2cqr/cqrlog
    cd cqrlog

    make
    sudo -A make install
}

REMOVE(){
    if [ -n "$IS_SUSE" ]; then
        PKG_REMOVE cqrlog
    else
        echo "removal tool for $ID not available at this time"
    fi
}


VERSION(){
	if ! hash cqrlog 2>/dev/null; then
	CURRENT=0
        NEWVER=$(curl -s https://raw.githubusercontent.com/ok2cqr/cqrlog/master/CHANGELOG | head | grep -w [0-9].[0-9].[0-9] | awk '{print $1}')
    else
        CURRENT=$(cqrlog -v | awk '{print $2}' | sed 's/Ver://')
        NEWVER=$(curl -s https://raw.githubusercontent.com/ok2cqr/cqrlog/master/CHANGELOG | head | grep -w [0-9].[0-9].[0-9] | awk '{print $1}')
    fi
}
